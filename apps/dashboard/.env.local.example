# ──────────────────────────────────────────────
# Nebula (apps/dashboard) — environment contract
# Copy to .env.local locally; in-cluster these come from SM via ESO/IRSA.
# ──────────────────────────────────────────────

# ── Database (Postgres; AuditLog + ActionNonce + User) ───────────────────
# No hosted DATABASE_URL exists yet (2026-09-07): .env.local points at a local
# Postgres; nothing under SM preview/* holds one. Provision Neon (or in-cluster
# Postgres) and run `pnpm db:migrate` (0002_action_nonce is pending).
DATABASE_URL=postgresql://user:PASSWORD@host/twizz_idp?sslmode=require

# ── Auth.js (GitHub OAuth; org-membership RBAC) ──────────────────────────
# OAuth App: https://github.com/organizations/twizz-app/settings/applications
# Callback URL: https://nebula.prv.twizz.com/api/auth/callback/github
NEXTAUTH_URL=https://nebula.prv.twizz.com
AUTH_SECRET=  # openssl rand -base64 32  (NEXTAUTH_SECRET also accepted)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_ORGS=twizz-app
ALLOWED_GITHUB_LOGINS=

# ── Nebula write path (@twizz-idp/actions gate) ──────────────────────────
# Platform token for twizz-gitops commits + named-envs reads (SM preview/github).
GITHUB_TOKEN=
# GitHub logins allowed to spin up / extend / re-clone / tear down. Others see READ-ONLY.
NEBULA_OPERATORS=nick,igor
# Same policy.yaml the MCP server enforces. Default: ../mcp/policy.yaml relative
# to the app dir (works in dev and in the standalone image), then ./policy.yaml.
NEBULA_POLICY_PATH=
NEBULA_MAX_NAMED_ENVS=6

# ── AWS (default credential chain: IRSA in-cluster, AWS_PROFILE locally) ─
# Needs: secretsmanager Get/Create/Delete on preview/moly-backend*, ecr:DescribeImages on molybackend.
AWS_REGION=eu-west-1
# AWS_PROFILE=twizz

# ── Argo health (in-cluster SA by default; locally point at a kubeconfig) ─
# KUBECONFIG=~/.kube/twizz-nonprod.yaml
# ARGOCD_NAMESPACE=argocd

# ── Introspection (pre-Nebula routes: /projects, /pipelines, /environments/topology)
GITHUB_ORG=twizz-app
VERCEL_TOKEN=
VERCEL_TEAM_ID=team_ocn3vwvvs3VDxcjxNcY7l8Mu
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_PROJECT_ID=
