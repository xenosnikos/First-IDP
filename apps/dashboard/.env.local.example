# ──────────────────────────────────────────────
# TWIZZ-IDP Dashboard - Environment Variables
# Copy to .env.local and fill in all values
# ──────────────────────────────────────────────

# ── Database (Neon Postgres; Vercel-integrated in prod) ─────────────────
DATABASE_URL=postgresql://user:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/twizz_idp?sslmode=require

# ── Auth.js (GitHub OAuth) ───────────────────
# OAuth App lives in the twizz-app org: https://github.com/organizations/twizz-app/settings/applications
# Callback URL: https://idp.twizz.app/api/auth/callback/github (or http://localhost:3000 locally)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=  # Generate: openssl rand -base64 32
GITHUB_CLIENT_ID=  # From GitHub OAuth App settings
GITHUB_CLIENT_SECRET=  # From GitHub OAuth App settings
GITHUB_ORG=twizz-app  # Primary org for repo listing

# ── RBAC ─────────────────────────────────────
# Active members of these GitHub orgs may sign in (comma-separated).
ALLOWED_GITHUB_ORGS=twizz-app,MymTwo
# Per-user fallback for collaborators outside the orgs (comma-separated logins).
ALLOWED_GITHUB_LOGINS=

# ── AWS (Secrets Manager reads, EKS/CloudWatch introspection) ────────────
# Local dev: AWS CLI profile. Vercel prod: OIDC federation -> twizz-dashboard-readonly role (no keys).
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=  # Only for local dev, prefer AWS_PROFILE instead
AWS_SECRET_ACCESS_KEY=  # Only for local dev, prefer AWS_PROFILE instead

# ── Argo CD (read-only app health, Phase 3+) ─────────────────────────────
ARGO_CD_URL=https://argocd.preview.twizz.app
ARGOCD_AUTH_TOKEN=  # read-only local account token

# ── Vercel (introspection + preview env wiring) ──────────────────────────
# Create token: https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_TEAM_ID=team_ocn3vwvvs3VDxcjxNcY7l8Mu

# ── MongoDB Atlas (introspection; preview db cleanup) ────────────────────
# Atlas -> Organization -> Access Manager -> API Keys
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_PROJECT_ID=
