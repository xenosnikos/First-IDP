datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ──────────────────────────────────────────────
// Users & audit
// ──────────────────────────────────────────────

model User {
  id          String     @id @default(cuid())
  githubLogin String     @unique
  githubId    String?    @unique
  name        String?
  email       String?
  avatarUrl   String?
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  auditLogs   AuditLog[]
}

// Append-only. One row per write action (dashboard mutation or MCP write tool),
// including denied attempts.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  actor     String // github login or "mcp:<tool>" when no session
  action    String // e.g. "signin", "project.create", "mcp.delete_preview"
  resource  String? // e.g. "pr-moly-backend-42"
  allowed   Boolean  @default(true)
  detail    Json?
  createdAt DateTime @default(now())

  @@index([actor, createdAt])
}

// ──────────────────────────────────────────────
// Projects & Environments
// ──────────────────────────────────────────────

model Project {
  id            String        @id @default(cuid())
  githubRepoUrl String        @unique
  name          String
  type          ProjectType
  defaultBranch String        @default("main")
  detectedDeps  Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  environments  Environment[]
}

enum ProjectType {
  FRONTEND
  BACKEND
  FULLSTACK
  UNKNOWN
}

model Environment {
  id             String            @id @default(cuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tier           EnvironmentTier
  namespace      String            @unique
  status         EnvironmentStatus @default(PROVISIONING)
  serviceUrl     String?
  ttlExpiresAt   DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deployConfig   DeployConfig?
  databaseConfig DatabaseConfig?
  pipelineRuns   PipelineRun[]
}

enum EnvironmentTier {
  DEV
  QA
  STAGING
  PREVIEW
  PRODUCTION
}

enum EnvironmentStatus {
  PROVISIONING
  RUNNING
  FAILED
  DESTROYING
  DESTROYED
}

model DeployConfig {
  id            String      @id @default(cuid())
  environmentId String      @unique
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  branch        String
  commitSha     String
  imageUri      String?
  replicas      Int         @default(1)
  cpuLimit      String      @default("500m")
  memLimit      String      @default("512Mi")
  secretSetName String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model DatabaseConfig {
  id                        String      @id @default(cuid())
  environmentId             String      @unique
  environment               Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  strategy                  DbStrategy
  atlasClusterId            String?
  connectionStringSecretRef String?
  createdAt                 DateTime    @default(now())
}

enum DbStrategy {
  CLONE
  SHARED
  NONE
}

// ──────────────────────────────────────────────
// Pipelines
// ──────────────────────────────────────────────

model PipelineRun {
  id               String         @id @default(cuid())
  environmentId    String
  environment      Environment    @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  argoWorkflowName String         @unique
  status           PipelineStatus @default(PENDING)
  startedAt        DateTime?
  completedAt      DateTime?
  logsUrl          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

enum PipelineStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}
