datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ──────────────────────────────────────────────
// Users & audit
// ──────────────────────────────────────────────

model User {
  id          String     @id @default(cuid())
  githubLogin String     @unique
  githubId    String?    @unique
  name        String?
  email       String?
  avatarUrl   String?
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  auditLogs   AuditLog[]
}

// Append-only. One row per write action (dashboard mutation or MCP write tool),
// including denied attempts.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  actor     String // github login or "mcp:<tool>" when no session
  action    String // e.g. "signin", "project.create", "mcp.delete_preview"
  resource  String? // e.g. "pr-moly-backend-42"
  allowed   Boolean  @default(true)
  detail    Json?
  createdAt DateTime @default(now())

  @@index([actor, createdAt])
}

// Two-step confirm nonces for gated write actions (@twizz-idp/actions
// PrismaNonceStore). Single-use, 5-minute TTL; expired rows are swept
// opportunistically on issue.
model ActionNonce {
  nonce       String   @id
  fingerprint String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}

// ──────────────────────────────────────────────
// Projects & Environments
// ──────────────────────────────────────────────

model Project {
  id            String        @id @default(cuid())
  githubRepoUrl String        @unique
  name          String
  type          ProjectType
  defaultBranch String        @default("main")
  detectedDeps  Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  environments  Environment[]
}

enum ProjectType {
  FRONTEND
  BACKEND
  FULLSTACK
  UNKNOWN
}

model Environment {
  id             String            @id @default(cuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tier           EnvironmentTier
  namespace      String            @unique
  status         EnvironmentStatus @default(PROVISIONING)
  serviceUrl     String?
  ttlExpiresAt   DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deployConfig   DeployConfig?
  databaseConfig DatabaseConfig?
  pipelineRuns   PipelineRun[]
}

enum EnvironmentTier {
  DEV
  QA
  STAGING
  PREVIEW
  PRODUCTION
}

enum EnvironmentStatus {
  PROVISIONING
  RUNNING
  FAILED
  DESTROYING
  DESTROYED
}

model DeployConfig {
  id            String      @id @default(cuid())
  environmentId String      @unique
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  branch        String
  commitSha     String
  imageUri      String?
  replicas      Int         @default(1)
  cpuLimit      String      @default("500m")
  memLimit      String      @default("512Mi")
  secretSetName String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model DatabaseConfig {
  id                        String      @id @default(cuid())
  environmentId             String      @unique
  environment               Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  strategy                  DbStrategy
  atlasClusterId            String?
  connectionStringSecretRef String?
  createdAt                 DateTime    @default(now())
}

enum DbStrategy {
  CLONE
  SHARED
  NONE
}

// ──────────────────────────────────────────────
// Pipelines
// ──────────────────────────────────────────────

model PipelineRun {
  id               String         @id @default(cuid())
  environmentId    String
  environment      Environment    @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  argoWorkflowName String         @unique
  status           PipelineStatus @default(PENDING)
  startedAt        DateTime?
  completedAt      DateTime?
  logsUrl          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

enum PipelineStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

// ──────────────────────────────────────────────
// Lifecycle (docs/NEBULA.md §N9)
// ──────────────────────────────────────────────

// One row per PLO job run, POSTed by the in-cluster publisher to
// /api/lifecycle/ingest and validated with @twizz-idp/shared
// `LifecycleSnapshotDoc` before it is stored. `data` is the PARSED snapshot
// (unknown keys stripped). Idempotent on `runId`; the ingest keeps the newest
// 60 rows per job.
model LifecycleSnapshot {
  id         String   @id @default(cuid())
  job        String // plan | source | cve | smoke
  runId      String   @unique
  ok         Boolean
  startedAt  DateTime
  finishedAt DateTime
  createdAt  DateTime @default(now()) // when Nebula received it (reset when a runId is replaced)
  data       Json

  @@index([job, createdAt])
}

// An on-demand run an operator asked for through the Nebula gate. The
// dashboard only writes this row; the `plo-dispatch` CronJob claims it
// (POST /api/lifecycle/requests/claim), runs it and completes it.
model LifecycleRequest {
  id          String    @id @default(cuid())
  kind        String // plan | cve | smoke
  params      Json
  requestedBy String // github login
  status      String    @default("pending") // pending | claimed | done | failed | expired
  createdAt   DateTime  @default(now())
  claimedAt   DateTime?
  finishedAt  DateTime?
  runId       String?
  error       String?

  @@index([status, createdAt])
}
